/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://lsoprwhjnurfqnsymhzf.supabase.co; media-src 'self' blob: https://lsoprwhjnurfqnsymhzf.supabase.co; connect-src 'self' https://lsoprwhjnurfqnsymhzf.supabase.co wss://lsoprwhjnurfqnsymhzf.supabase.co https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src https://amna-bi-bi.vercel.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  X-XSS-Protection: 0

# HTML pages: always revalidate so a deploy is visible immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/signup.html
  Cache-Control: public, max-age=0, must-revalidate

/clinic.html
  Cache-Control: public, max-age=0, must-revalidate

/academy.html
  Cache-Control: public, max-age=0, must-revalidate

/restaurant.html
  Cache-Control: public, max-age=0, must-revalidate

/generalstore.html
  Cache-Control: public, max-age=0, must-revalidate

/beautysalon.html
  Cache-Control: public, max-age=0, must-revalidate

/petrolpump.html
  Cache-Control: public, max-age=0, must-revalidate

/medicalstore.html
  Cache-Control: public, max-age=0, must-revalidate

/laboratory.html
  Cache-Control: public, max-age=0, must-revalidate

# Styles and scripts: always revalidate (the ?v= query string also busts caches).
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Images are versioned with ?v= in the markup, so a one-day cache is safe.
/assets/img/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
